# Turso / libSQL. Si NO defines estas variables, en local se usa el archivo
# data/deudas.db automaticamente (cero setup para desarrollar).
TURSO_DATABASE_URL=libsql://tu-base.turso.io
TURSO_AUTH_TOKEN=

# Cerrar el registro publico una vez creada tu cuenta (recomendado en produccion).
# La primera cuenta SIEMPRE se puede crear, aunque este en 0.
ALLOW_SIGNUP=1
